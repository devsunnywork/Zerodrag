# Ignore all files by default in the workspace root
/*

# Exclude core repository documentation and website
!.gitignore
!README.md
!GDD.md
!StoryDesign.md
!Website/

# Allow scanning of Assets folder but ignore its contents
!Assets/
Assets/*

# Strictly exclude the Scripts folder and its contents
!Assets/Scripts/
!Assets/Scripts/**
!Assets/Scripts.meta

# Ignore general Unity junk folders globally
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Uu]serSettings/
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svclog
*.pdb
*.mdb
*.opendb
*.db
*.VC.db
